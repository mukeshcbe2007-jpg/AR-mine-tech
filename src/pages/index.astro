---
// index.astro - AR Mine Homepage
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Features from '../components/Features.astro';
import MiningSection from '../components/MiningSection.astro';
import ManufacturingSection from '../components/ManufacturingSection.astro';
import Workflow from '../components/Workflow.astro';
import Benefits from '../components/Benefits.astro';
import FutureScope from '../components/FutureScope.astro';
import Team from '../components/Team.astro';
import BlogCard from '../components/BlogCard.astro';
---

<Layout 
  title="AR Mine | Augmented Reality for Industrial Safety"
  description="AR Mine explores how Augmented Reality can improve safety awareness, training, equipment understanding, and workplace guidance across mining and manufacturing environments."
  currentPath="/"
>
  <!-- 1. Hero Section -->
  <Hero />

  <!-- 2. About AR Mine & 3. Why AR for Safety -->
  <About />

  <!-- 4. Key Features -->
  <Features />

  <!-- 5. AR Mine in Mining & 6. AR Mine in Manufacturing -->
  <div id="industries">
    <MiningSection />
    <ManufacturingSection />
  </div>

  <!-- 7. How AR Mine Works -->
  <Workflow />

  <!-- 8. Benefits -->
  <Benefits />

  <!-- 9. Future Scope -->
  <FutureScope />

  <!-- 10. About Us / Crew Stars Team -->
  <Team />

  <!-- 11. Latest Blog / Insights Preview -->
  <section class="section">
    <div class="container">
      <div class="section-header reveal-on-scroll">
        <span class="section-tag">Featured Knowledge</span>
        <h2 class="section-title">AR Mine Insights</h2>
        <p class="section-subtitle">
          Exploring Augmented Reality, industrial safety, mining technology, manufacturing, and the future of intelligent workplaces.
        </p>
      </div>

      <div class="insights-preview-grid">
        <!-- Main Featured Blog Article -->
        <BlogCard 
          title="AR Mine: Transforming Safety Through Augmented Reality"
          slug="ar-mine-transforming-safety"
          category="Augmented Reality · Industrial Safety"
          description="How combining Augmented Reality, 3D visualization, and interactive safety information creates a smarter, more accessible approach to heavy industrial operations."
          readTime="7 min read"
          date="September 2026"
          imageSrc="/assets/armine-ar-practice.png"
          featured={true}
          delay={50}
        />

        <!-- Secondary Insight 1 -->
        <BlogCard 
          title="Subterranean Spatial Awareness: Overcoming GPS Limits with AR"
          slug="ar-mine-transforming-safety#mining"
          category="Mining Technology"
          description="Navigating complex underground shaft networks using optical markers and point-cloud spatial anchors for emergency route discovery."
          readTime="5 min read"
          date="September 2026"
          imageSrc="/assets/armine-emergency-overlay.png"
          delay={120}
        />

        <!-- Secondary Insight 2 -->
        <BlogCard 
          title="Eliminating Cognitive Overhead on Factory Floors"
          slug="ar-mine-transforming-safety#manufacturing"
          category="Manufacturing Safety"
          description="Why interactive holographic SOPs outperform 400-page paper binders during critical machine maintenance and lockout procedures."
          readTime="4 min read"
          date="September 2026"
          imageSrc="/assets/armine-lesson.png"
          delay={190}
        />
      </div>

      <div class="all-insights-cta reveal-on-scroll">
        <a href="/blog" class="btn btn-secondary btn-lg">
          <span>Explore All Articles & Publications</span>
          <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .insights-preview-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 3.5rem;
  }

  @media (min-width: 640px) {
    .insights-preview-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .insights-preview-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .all-insights-cta {
    display: flex;
    justify-content: center;
  }
</style>
