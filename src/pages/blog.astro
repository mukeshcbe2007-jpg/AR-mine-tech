---
// blog.astro - AR Mine Insights Blog Listing
import Layout from '../layouts/Layout.astro';
import BlogCard from '../components/BlogCard.astro';

const articles = [
  {
    title: "AR Mine: Transforming Safety Through Augmented Reality",
    slug: "ar-mine-transforming-safety",
    category: "Augmented Reality · Safety",
    description: "Discover how combining Augmented Reality, 3D visualization, and interactive safety information creates a smarter, more accessible approach to heavy industrial operations.",
    readTime: "7 min read",
    date: "September 2026",
    featured: true,
    imageSrc: "/assets/armine-ar-practice.png"
  },
  {
    title: "Subterranean Spatial Awareness: Overcoming GPS Blindspots in Underground Mining",
    slug: "ar-mine-transforming-safety#mining",
    category: "Mining Technology",
    description: "How optical SLAM and marker-based point clouds allow subterranean personnel to access precise hazard maps without external satellite positioning.",
    readTime: "5 min read",
    date: "September 2026",
    imageSrc: "/assets/armine-emergency-overlay.png"
  },
  {
    title: "Eliminating Cognitive Overhead on Factory Floors with Holographic SOPs",
    slug: "ar-mine-transforming-safety#manufacturing",
    category: "Manufacturing Innovation",
    description: "Analyzing the transition from paper maintenance checklists to interactive step-by-step AR demonstrations during machine maintenance cycles.",
    readTime: "4 min read",
    date: "September 2026",
    imageSrc: "/assets/armine-lesson.png"
  },
  {
    title: "The Human Element in Industrial AR: Designing Interfaces for Zero Distraction",
    slug: "ar-mine-transforming-safety#features",
    category: "Industrial UI/UX",
    description: "Design guidelines for heads-up displays in extreme environments: high contrast, minimal obstruction, and glanceable telemetry.",
    readTime: "6 min read",
    date: "September 2026",
    imageSrc: "/assets/armine-worker-dashboard.png"
  },
  {
    title: "From Static Binders to Experiential Immersion: The Evolution of Safety Training",
    slug: "ar-mine-transforming-safety#why-ar",
    category: "Workforce Training",
    description: "Why hands-on practice in an augmented environment increases emergency procedure retention by up to fourfold compared to video lectures.",
    readTime: "5 min read",
    date: "September 2026",
    imageSrc: "/assets/armine-training-category.png"
  },
  {
    title: "The Road to Autonomous Safety: Merging Computer Vision and IoT with AR",
    slug: "ar-mine-transforming-safety#future",
    category: "Future Horizon",
    description: "An exploratory look into how distributed sensor networks and computer vision classification could enable predictive safety alerts in future facilities.",
    readTime: "6 min read",
    date: "September 2026",
    imageSrc: "/assets/armine-admin-dashboard.png"
  }
];
---

<Layout 
  title="AR Mine Insights | Augmented Reality & Industrial Safety Blog"
  description="Exploring Augmented Reality, industrial safety, mining technology, manufacturing, and the future of intelligent workplaces by Crew Stars."
  currentPath="/blog"
>
  <!-- Blog Header -->
  <section class="blog-header-section">
    <div class="container">
      <div class="blog-header-inner">
        <span class="section-tag">
          <span class="pulse-dot"></span>
          Editorial & Research
        </span>
        <h1 class="page-title">AR Mine Insights</h1>
        <p class="page-lead">
          Exploring Augmented Reality, industrial safety, mining technology, manufacturing, and the future of intelligent workplaces.
        </p>

        <!-- Topic Badges Filter Bar -->
        <div class="topics-filter-bar">
          <button class="filter-pill active">All Articles</button>
          <button class="filter-pill">Augmented Reality</button>
          <button class="filter-pill">Mining Safety</button>
          <button class="filter-pill">Manufacturing</button>
          <button class="filter-pill">Industrial UX</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Main Article Callout -->
  <section class="section" style="padding-top: 3.5rem;">
    <div class="container">
      <div class="primary-feature-block card reveal-on-scroll">
        <div class="feature-grid">
          <div class="feature-image-wrap ar-reticle-frame">
            <img 
              src="/assets/armine-ar-practice.png" 
              alt="AR Mine Safety Interface Prototype" 
              class="feature-img"
              loading="eager"
            />
            <span class="feature-stamp">CORE MONOGRAPH</span>
          </div>

          <div class="feature-content-wrap">
            <div class="fc-meta">
              <span class="fc-cat">FEATURED PUBLICATION</span>
              <span class="fc-time">7 min read · Sept 2026</span>
            </div>

            <h2 class="fc-title">
              <a href="/blog/ar-mine-transforming-safety">
                AR Mine: Transforming Safety Through Augmented Reality
              </a>
            </h2>

            <p class="fc-desc">
              Safety is one of the most critical aspects of mining and manufacturing. Explore how AR Mine uses Augmented Reality, 3D visualization, and interactive safety procedures to bridge the gap between theoretical knowledge and real-world high-hazard environments.
            </p>

            <div class="fc-footer">
              <a href="/blog/ar-mine-transforming-safety" class="btn btn-primary btn-md">
                <span>Read Full Article</span>
                <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </a>
              <span class="fc-author">By Crew Stars · AR Mine Project</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Articles Grid -->
      <div class="all-articles-heading">
        <h3>Curated Insights & Field Studies</h3>
        <span class="articles-count">6 Publications</span>
      </div>

      <div class="articles-grid">
        {articles.map((item, idx) => (
          <BlogCard 
            title={item.title}
            slug={item.slug}
            category={item.category}
            description={item.description}
            readTime={item.readTime}
            date={item.date}
            imageSrc={item.imageSrc}
            delay={idx * 60}
          />
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .blog-header-section {
    padding-top: 5rem;
    padding-bottom: 3.5rem;
    background: radial-gradient(circle at 50% 0%, rgba(239, 246, 255, 0.7) 0%, rgba(255, 255, 255, 0) 70%);
    border-bottom: 1px solid var(--border-subtle);
  }

  .blog-header-inner {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  .page-title {
    margin-top: 1rem;
    margin-bottom: 1.25rem;
    color: var(--text-primary);
  }

  .page-lead {
    font-size: 1.2rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 2.25rem;
  }

  .topics-filter-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .filter-pill {
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    padding: 0.45rem 1rem;
    border-radius: var(--radius-full);
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-pill:hover {
    border-color: var(--border-medium);
    color: var(--text-primary);
  }

  .filter-pill.active {
    background-color: var(--text-primary);
    border-color: var(--text-primary);
    color: #FFFFFF;
  }

  /* Primary Feature Block */
  .primary-feature-block {
    padding: 1.75rem;
    margin-bottom: 4rem;
    border-color: var(--accent-blue-border);
    box-shadow: var(--shadow-md);
  }

  .feature-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .feature-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  .feature-image-wrap {
    border-radius: var(--radius-md);
    overflow: hidden;
    position: relative;
    height: 320px;
    background-color: var(--bg-tertiary);
  }

  .feature-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .feature-stamp {
    position: absolute;
    top: 1rem;
    left: 1rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--accent-blue);
    background-color: rgba(255, 255, 255, 0.95);
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--accent-blue-border);
  }

  .feature-content-wrap {
    display: flex;
    flex-direction: column;
  }

  .fc-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.85rem;
  }

  .fc-cat {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent-blue);
    letter-spacing: 0.05em;
  }

  .fc-time {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .fc-title {
    font-size: 1.85rem;
    line-height: 1.25;
    margin-bottom: 1rem;
  }

  .fc-title a {
    color: var(--text-primary);
  }

  .fc-title a:hover {
    color: var(--accent-blue);
  }

  .fc-desc {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  .fc-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  .fc-author {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  /* Articles Grid */
  .all-articles-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-light);
  }

  .all-articles-heading h3 {
    font-size: 1.4rem;
  }

  .articles-count {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    background-color: var(--bg-secondary);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
  }

  .articles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 640px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .articles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
