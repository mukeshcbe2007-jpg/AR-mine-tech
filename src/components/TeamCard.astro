---
// TeamCard.astro - Clean, professional team member profile card
interface Props {
  name: string;
  role: string;
  isLeader?: boolean;
  initials: string;
  imageSrc?: string;
  delay?: number;
}

const { name, role, isLeader = false, initials, imageSrc, delay = 0 } = Astro.props;
---

<div class={`team-card card reveal-on-scroll ${isLeader ? 'team-card-leader' : ''}`} data-reveal-delay={delay}>
  {isLeader && (
    <div class="leader-badge">
      <span class="star-icon">★</span>
      <span>PROJECT LEAD</span>
    </div>
  )}

  <div class="avatar-container">
    {imageSrc ? (
      <img src={imageSrc} alt={name} class="avatar-image" loading="lazy" />
    ) : (
      <div class={`avatar-initials ${isLeader ? 'avatar-initials-leader' : ''}`}>
        <span>{initials}</span>
      </div>
    )}
    <div class="avatar-ring"></div>
  </div>

  <div class="team-meta">
    <h3 class="team-name">{name}</h3>
    <span class={`team-role ${isLeader ? 'role-leader' : ''}`}>{role}</span>
  </div>

  <div class="team-card-footer">
    <span class="team-tag">Crew Stars</span>
    <span class="team-project">AR Mine</span>
  </div>
</div>

<style>
  .team-card {
    padding: 2.25rem 1.75rem;
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    transition: all var(--transition-normal);
  }

  .team-card:hover {
    border-color: var(--accent-blue-border);
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
  }

  .team-card-leader {
    border-color: var(--accent-blue-border);
    background: linear-gradient(180deg, #FFFFFF 0%, #F8FAFC 100%);
    box-shadow: 0 4px 20px -2px rgba(37, 99, 235, 0.08);
    padding: 2.75rem 2rem;
  }

  .leader-badge {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--accent-blue);
    background-color: var(--accent-blue-subtle);
    border: 1px solid var(--accent-blue-border);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-full);
  }

  .star-icon {
    font-size: 0.75rem;
  }

  .avatar-container {
    position: relative;
    width: 86px;
    height: 86px;
    margin-bottom: 1.25rem;
  }

  .team-card-leader .avatar-container {
    width: 98px;
    height: 98px;
  }

  .avatar-initials {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background-color: var(--bg-tertiary);
    border: 2px solid var(--border-medium);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-secondary);
    box-shadow: var(--shadow-sm);
  }

  .avatar-initials-leader {
    background-color: var(--accent-blue-subtle);
    border-color: var(--accent-blue);
    color: var(--accent-blue);
    font-size: 1.75rem;
  }

  .avatar-image {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--border-subtle);
  }

  .team-meta {
    margin-bottom: 1.5rem;
  }

  .team-name {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.35rem;
  }

  .team-card-leader .team-name {
    font-size: 1.55rem;
  }

  .team-role {
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .role-leader {
    color: var(--accent-blue);
    font-weight: 700;
  }

  .team-card-footer {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-light);
    width: 100%;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .team-tag {
    color: var(--text-muted);
  }

  .team-project {
    color: var(--accent-blue);
    font-weight: 600;
  }
</style>
