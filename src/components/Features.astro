---
// Features.astro - 6 Key Features of AR Mine
const features = [
  {
    num: "01",
    title: "Hazard Identification",
    desc: "AR Mine can help workers identify potential hazards in their surroundings through visual markers and digital overlays.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />`,
    badge: "Spatial Detection"
  },
  {
    num: "02",
    title: "Equipment Information",
    desc: "Provide digital information about machines, components, operating procedures, and safety precautions through an interactive AR interface.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />`,
    badge: "Telemetry & Specs"
  },
  {
    num: "03",
    title: "Interactive Safety Training",
    desc: "Use AR-based demonstrations to make important safety concepts easier to understand and remember.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />`,
    badge: "Experiential Learning"
  },
  {
    num: "04",
    title: "Real-Time Guidance",
    desc: "Provide step-by-step visual instructions while a worker performs a specific task.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`,
    badge: "Step-by-Step SOP"
  },
  {
    num: "05",
    title: "Emergency Awareness",
    desc: "Present evacuation routes, emergency equipment locations, and basic emergency response information through visual instructions.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />`,
    badge: "Rapid Response"
  },
  {
    num: "06",
    title: "User-Friendly Interface",
    desc: "Provide a clean and simple interface so users can access important safety information without unnecessary complexity.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />`,
    badge: "Minimal UX"
  }
];
---

<section id="features" class="section section-alt">
  <div class="container">
    <div class="section-header reveal-on-scroll">
      <span class="section-tag">Core Capabilities</span>
      <h2 class="section-title">Key Features of AR Mine</h2>
      <p class="section-subtitle">
        Engineered specifically for extreme industrial reliability, intuitive spatial comprehension, and immediate worker empowerment.
      </p>
    </div>

    <div class="features-grid">
      {features.map((item, index) => (
        <div class="feature-card card reveal-on-scroll" data-reveal-delay={index * 80}>
          <div class="feature-card-top">
            <span class="feature-num">{item.num}</span>
            <span class="feature-badge">{item.badge}</span>
          </div>

          <div class="feature-icon-wrapper">
            <svg class="feature-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <Fragment set:html={item.icon} />
            </svg>
          </div>

          <h3 class="feature-title">{item.title}</h3>
          <p class="feature-desc">{item.desc}</p>

          <div class="card-edge-accent"></div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 640px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .features-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .feature-card {
    display: flex;
    flex-direction: column;
    padding: 2.25rem;
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    position: relative;
    transition: all var(--transition-normal);
  }

  .feature-card:hover {
    border-color: var(--accent-blue-border);
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
  }

  .feature-card:hover .feature-icon-wrapper {
    background-color: var(--accent-blue);
    color: #FFFFFF;
  }

  .feature-card:hover .card-edge-accent {
    opacity: 1;
    transform: scaleX(1);
  }

  .feature-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .feature-num {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--accent-blue);
  }

  .feature-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-muted);
    background-color: var(--bg-secondary);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
  }

  .feature-icon-wrapper {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background-color: var(--accent-blue-subtle);
    color: var(--accent-blue);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    transition: all var(--transition-normal);
  }

  .feature-icon {
    width: 24px;
    height: 24px;
  }

  .feature-title {
    margin-bottom: 0.75rem;
    font-size: 1.3rem;
  }

  .feature-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .card-edge-accent {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--accent-blue), #38BDF8);
    opacity: 0;
    transform: scaleX(0.2);
    transition: all var(--transition-normal);
  }
</style>
