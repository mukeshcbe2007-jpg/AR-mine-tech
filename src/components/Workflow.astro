---
// Workflow.astro - How AR Mine Works (5-Step Interactive Process)
const steps = [
  {
    step: "01",
    name: "Real-World Environment",
    desc: "Physical workplace comprising machinery, tunnel structures, operational zones, and potential hazards.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />`
  },
  {
    step: "02",
    name: "AR Camera",
    desc: "High-definition camera and optical sensors capture real-time spatial video feeds from mobile or AR headsets.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />`
  },
  {
    step: "03",
    name: "Object / Area Recognition",
    desc: "Intelligent spatial recognition maps equipment tags, restricted zone boundaries, and critical machine parts.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />`
  },
  {
    step: "04",
    name: "Digital Information",
    desc: "Real-time telemetry, pressure readings, maintenance warnings, and emergency routes are rendered contextually.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />`
  },
  {
    step: "05",
    name: "Safety Guidance",
    desc: "Workers interact with high-visibility holographic overlays and follow precise step-by-step procedures.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />`
  }
];
---

<section id="workflow" class="section">
  <div class="container">
    <div class="section-header reveal-on-scroll">
      <span class="section-tag">System Architecture</span>
      <h2 class="section-title">How AR Mine Works</h2>
      <p class="section-subtitle">
        The user accesses the AR application through a compatible device. The system observes the surrounding environment, identifies relevant objects or locations, and displays digital safety information over the real-world view.
      </p>
    </div>

    <!-- Timeline Container -->
    <div class="workflow-timeline-wrapper">
      <div class="timeline-track" aria-hidden="true"></div>

      <div class="workflow-grid">
        {steps.map((item, index) => (
          <div class="workflow-step-card card reveal-on-scroll" data-reveal-delay={index * 100}>
            <div class="step-num-badge">{item.step}</div>
            
            <div class="step-icon-container">
              <svg class="step-svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <Fragment set:html={item.icon} />
              </svg>
            </div>

            <h3 class="step-title">{item.name}</h3>
            <p class="step-description">{item.desc}</p>

            {index < steps.length - 1 && (
              <div class="step-connector-arrow" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .workflow-timeline-wrapper {
    position: relative;
    margin-top: 2rem;
  }

  .timeline-track {
    display: none;
    position: absolute;
    top: 60px;
    left: 4%;
    right: 4%;
    height: 2px;
    background: linear-gradient(90deg, #E2E8F0 0%, #2563EB 50%, #E2E8F0 100%);
    z-index: 1;
  }

  @media (min-width: 1024px) {
    .timeline-track {
      display: block;
    }
  }

  .workflow-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    position: relative;
    z-index: 2;
  }

  @media (min-width: 640px) {
    .workflow-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .workflow-grid {
      grid-template-columns: repeat(5, 1fr);
      gap: 1rem;
    }
  }

  .workflow-step-card {
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.75rem 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    transition: all var(--transition-normal);
  }

  .workflow-step-card:hover {
    border-color: var(--accent-blue);
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }

  .step-num-badge {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: #FFFFFF;
    border: 2px solid var(--accent-blue);
    color: var(--accent-blue);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 0.95rem;
    box-shadow: 0 2px 8px rgba(37, 99, 235, 0.15);
    margin-bottom: 1.25rem;
    transition: transform var(--transition-fast);
  }

  .step-icon-container {
    width: 46px;
    height: 46px;
    border-radius: var(--radius-md);
    background-color: var(--accent-blue-subtle);
    color: var(--accent-blue);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .step-svg {
    width: 22px;
    height: 22px;
  }

  .step-title {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 0.65rem;
    color: var(--text-primary);
  }

  .step-description {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .step-connector-arrow {
    display: none;
    position: absolute;
    right: -14px;
    top: 50%;
    transform: translateY(-50%);
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background-color: #FFFFFF;
    border: 1px solid var(--border-medium);
    align-items: center;
    justify-content: center;
    color: var(--accent-blue);
    box-shadow: var(--shadow-xs);
    z-index: 3;
  }

  @media (min-width: 1024px) {
    .step-connector-arrow {
      display: flex;
    }
  }
</style>
